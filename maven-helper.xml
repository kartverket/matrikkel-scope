<?xml version="1.0"?>

<!--
This is a helper build file for the Maven build.
For some reason, this doesn't work from Maven, so
Maven will invoke Ant instead.
-->

<project name="Maven Helper" default="history" basedir=".">

   <target name="history">
    <loadfile property="CHANGES" srcFile="${maven.build.dir}/history.txt" />
    <copy file="${basedir}/xdocs/changes.tmpl" tofile="${basedir}/xdocs/changes.xml" overwrite="true">
      <filterset>
        <filter token="CHANGES" value="${CHANGES}" />
      </filterset>
    </copy>
   </target>

</project>

