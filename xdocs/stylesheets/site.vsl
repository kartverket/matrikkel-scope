<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">

<!-- Content Stylesheet for Site -->
    ## Defined variables
    #set ($bodybg = "#ffffff")
    #set ($bodyfg = "#000000")
    #set ($bodylink = "#525D76")
    #set ($bannerbg = "#525D76")
    #set ($bannerfg = "#ffffff")
    #set ($subbannerbg = "#828DA6")
    #set ($subbannerfg = "#ffffff")
    #set ($tablethbg = "#039acc")
    #set ($tabletdbg = "#a0ddf0")
    #set ($pagetop = "#000066")

<!-- start the processing -->
#document()
<!-- end the processing -->

## This is where the macro's live

#macro ( p $p)
<p>
  $p.getText()
    #foreach ( $items in $p.getChildren() )
        #if ($items.getName().equals("ol"))
            #ol ($items)
        #elseif ($items.getName().equals("ul"))
            #ul ($items)
        #elseif ($items.getName().equals("source"))
            #source_inc ($items)
        #else
            $items 
        #end
    #end
</p>
#end

#macro ( ol $ol)
<ol>
    #foreach ( $items in $ol.getChildren() )
        #if ($items.getName().equals("li"))
            #li ($items)
        #end
    #end
</ol>
#end

#macro ( ul $ul)
<ol>
    #foreach ( $items in $ul.getChildren() )
        #if ($items.getName().equals("li"))
            #li ($items)
        #end
    #end
</ol>
#end

#macro ( li $li)
<li>
  $li.getText()
    #foreach ( $items in $li.getChildren() )
        #if ($items.getName().equals("source"))
            #source_inc ($items)
        #else
            $items
        #end
    #end
</li>
#end

#macro ( table $table)
<table>
    #foreach ( $items in $table.getChildren() )
        #if ($items.getName().equals("tr"))
            #tr ($items)
        #end
    #end
</table>
#end

#macro ( tr $tr)
<tr>
    #foreach ( $items in $tr.getChildren() )
        #if ($items.getName().equals("td"))
            #td ($items)
        #elseif ($items.getName().equals("th"))
            #th ($items)
        #end
    #end
</tr>
#end

#macro ( td $value)
#if ($value.getAttributeValue("colspan"))
#set ($colspan = $value.getAttributeValue("colspan"))
#end
#if ($value.getAttributeValue("rowspan"))
#set ($rowspan = $value.getAttributeValue("rowspan"))
#end
<td bgcolor="$tabletdbg" colspan="$!colspan" rowspan="$!rowspan" valign="top" align="left">
    <font color="#000000" size="-1" face="arial,helvetica,sanserif">
        #if ($value.getText().length() != 0 || $value.hasChildren())
        $value.getContent()
        #else
        &nbsp;
        #end
    </font>
</td>
#end

#macro ( th $value)
#if ($value.getAttributeValue("colspan"))
#set ($colspan = $value.getAttributeValue("colspan"))
#end
#if ($value.getAttributeValue("rowspan"))
#set ($rowspan = $value.getAttributeValue("rowspan"))
#end
<td bgcolor="$tablethbg" colspan="$!colspan" rowspan="$!rowspan" valign="top" align="left">
    <font color="#000000" size="-1" face="arial,helvetica,sanserif">
        #if ($value.getText().length() != 0 || $value.hasChildren())
        $value.getContent()
        #else
        &nbsp;
        #end
    </font>
</td>
#end

#macro ( projectanchor $name $value )
#if ($value.startsWith("http://"))
    <a href="$value">$name</a>
#elseif ($value.startsWith("/site"))
    <a href="http://$value.sf.net">$name</a>
#else
    <a href="$relativePath$value">$name</a>
#end
#end

#macro ( metaauthor $author $email )
            <meta name="author" value="$author">
            <meta name="email" value="$email">
#end

#macro ( image $value )
#if ($value.getAttributeValue("width"))
#set ($width=$value.getAttributeValue("width"))
#end
#if ($value.getAttributeValue("height"))
#set ($height=$value.getAttributeValue("height"))
#end
#if ($value.getAttributeValue("align"))
#set ($align=$value.getAttributeValue("align"))
#end
<img src="$relativePath$value.getAttributeValue("src")" width="$!width" height="$!height" align="$!align">
#end

#macro ( source $value)
    <div align="left">
    #source_inc ($value)
    </div>
#end

#macro ( source_inc $value)
    <table cellspacing="0" cellpadding="0" border="0">
    <tr>
      <td bgcolor="#023264" width="2" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
      <td bgcolor="#023264" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
      <td bgcolor="#023264" width="2" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
    </tr>
    <tr>
      <td bgcolor="#023264" width="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
      <td bgcolor="#ffffff"><pre>$escape.getText($value.getText())</pre></td>
      <td bgcolor="#023264" width="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
    </tr>
    <tr>
      <td bgcolor="#023264" width="2" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
      <td bgcolor="#023264" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
      <td bgcolor="#023264" width="2" height="2"><img src="images/void.gif" width="2" height="2" vspace="0" hspace="0" border="0"/></td>
    </tr>
    </table>
#end

#macro ( subsection $subsection)
    <table border="0" cellspacing="0" cellpadding="2" width="100%">
      <tr><td bgcolor="$subbannerbg">
        <font color="$subbannerfg" face="arial,helvetica,sanserif">
          <a name="$subsection.getAttributeValue("name")"><strong>$subsection.getAttributeValue("name")</strong></a>
        </font>
      </td></tr>
      <tr><td>
        <blockquote>
        #foreach ( $items in $subsection.getChildren() )
            #if ($items.getName().equals("img"))
                #image ($items)
            #elseif ($items.getName().equals("source"))
                #source ($items)
            #elseif ($items.getName().equals("table"))
                #table ($items)
            #elseif ($items.getName().equals("p"))
                #p ($items)
            #else
                $items
            #end
        #end
        </blockquote>
      </td></tr>
      <tr><td><br/></td></tr>
    </table>
#end


#macro ( section $section)
    <table border="0" cellspacing="0" cellpadding="2" width="100%">
      <tr><td bgcolor="$bannerbg">
        <font color="$bannerfg" face="arial,helvetica,sanserif">
          <a name="$section.getAttributeValue("name")"><strong>$section.getAttributeValue("name")</strong></a>
        </font>
      </td></tr>
      <tr><td>
        <blockquote>
        #foreach ( $items in $section.getChildren() )
            #if ($items.getName().equals("img"))
                #image ($items)
            #elseif ($items.getName().equals("source"))
                #source ($items)
            #elseif ($items.getName().equals("table"))
                #table ($items)
            #elseif ($items.getName().equals("subsection"))
                #subsection ($items)
            #elseif ($items.getName().equals("p"))
                #p ($items)
            #else
                $items
            #end
        #end
        </blockquote>
        </p>
      </td></tr>
      <tr><td><br/></td></tr>
    </table>
#end

#macro ( relativeLinks $node)
#set ($href = $node.getAttributeValue("href"))
#if (!$href.startsWith("http:") && !$href.startsWith("/"))
$relativePath/$href#else$href#end
#end

#macro ( makeProject )
    <link rel="styleSheet" href="$relativePath/resources/xtree.css" type="text/css"/>
    <script type="text/javascript" src="$relativePath/resources/xtree.js"></script>
    <script type="text/javascript">
    /// XP Look
    webFXTreeConfig.rootIcon          = "$relativePath/images/xtree/folder.png";
    webFXTreeConfig.openRootIcon      = "$relativePath/images/xtree/openfolder.png";
    webFXTreeConfig.folderIcon        = "$relativePath/images/xtree/folder.png";
    webFXTreeConfig.openFolderIcon    = "$relativePath/images/xtree/openfolder.png";
    webFXTreeConfig.fileIcon          = "$relativePath/images/xtree/file.png";
    webFXTreeConfig.lMinusIcon        = "$relativePath/images/xtree/Lminus.png";
    webFXTreeConfig.lPlusIcon         = "$relativePath/images/xtree/Lplus.png";
    webFXTreeConfig.tMinusIcon        = "$relativePath/images/xtree/Tminus.png";
    webFXTreeConfig.tPlusIcon         = "$relativePath/images/xtree/Tplus.png";
    webFXTreeConfig.iIcon             = "$relativePath/images/xtree/I.png";
    webFXTreeConfig.lIcon             = "$relativePath/images/xtree/L.png";
    webFXTreeConfig.tIcon             = "$relativePath/images/xtree/T.png";
    webFXTreeConfig.blankIcon         = "$relativePath/images/xtree/blank.png";

    var root = new WebFXTree("Scope");

    #set ($menus = $project.getChild("body").getChildren("menu"))
    #foreach ( $menu in $menus )
        #set ( $menu_node_name = "menu_$velocityCount" )
        #if( $menu.getAttributeValue("href") )
        var $menu_node_name = new WebFXTreeItem("$menu.getAttributeValue("name")", "#relativeLinks($menu)");
        #else
        var $menu_node_name = new WebFXTreeItem("$menu.getAttributeValue("name")");
        #end
        #foreach ( $item in $menu.getChildren() )
            #set ($name = $item.getAttributeValue("name"))
            #set ($item_node_name = "item_$velocityCount")
            var $item_node_name = new WebFXTreeItem("$name", "#relativeLinks($item)");
            ${menu_node_name}.add(${item_node_name});
            #foreach ( $subitem in $item.getChildren() )
                #set ($subname = $subitem.getAttributeValue("name"))
                ${item_node_name}.add(new WebFXTreeItem("$subname", "#relativeLinks($subitem)"));
            #end
        #end
        root.add(${menu_node_name});
    #end

    document.write(root);
    </script>
#end

#macro (getProjectImage)
#if ($project.getChild("logo"))
<td align="left" bgcolor="$pagetop">
<a href="http://scope.sf.net/"><img src="$relativePath/images/logo.gif" border="0"/></a>
</td>
<td align="right" bgcolor="$pagetop">
#set ( $logoString = $project.getChild("logo").getAttributeValue("href") )
#if ( $logoString.startsWith("/") )
<a href="$project.getAttributeValue("href")"><img src="$relativePath$logoString" alt="$project.getChild("logo").getText()" border="0"/></a>
#else
<a href="$project.getAttributeValue("href")"><img src="$relativePath/$logoString" alt="$project.getChild("logo").getText()" border="0"/></a>
#end
</td>
#else
<td colspan="2" bgcolor="$pagetop">
<a href="http://scope.sf.net/"><img src="$relativePath/images/logo.gif" align="left" border="0"/></a>
</td>
#end
#end

#macro (printMeta $metaElement)
<meta #set ($attribs = $metaElement.getAttributes())
#foreach ($a in $attribs) $a.getName()="$a.getValue()" #end />
#end

#macro (document)
    <!-- ====================================================================== -->
    <!-- Main Page Section -->
    <!-- ====================================================================== -->
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/>
            <meta name="keywords" content="MVC, Model, View, Controller, Application, Framework, Development, Java, Steven, Swing, Servlet, Steve, Meyfroidt, Scope, ScopeMVC"/>

            #set ($authors = $root.getChild("properties").getChildren("author"))
            #foreach ( $au in $authors )
                #metaauthor ( $au.getText() $au.getAttributeValue("email") )
            #end

           #set ($metas = $root.getChildren("meta"))

            ##    Parse meta directives such as
            ##    <meta name="keyword" content="jakarta, java"/>
            #foreach ($meta in $metas) #printMeta($meta) #end

            <title>$project.getChild("title").getText() - $root.getChild("properties").getChild("title").getText()</title>
        </head>

        <body bgcolor="$bodybg" text="$bodyfg" link="$bodylink">
            <table border="0" width="100%" cellspacing="0">
                <!-- TOP IMAGE -->
                <tr>
                    #getProjectImage()
                </tr>
            </table>
            <table border="0" width="100%" cellspacing="4">
                <tr><td colspan="2">
                    <hr noshade="" size="1"/>
                </td></tr>

                <tr>
                    <!-- LEFT SIDE NAVIGATION -->

                    <td width="20%" valign="top" nowrap="true">
                    #makeProject()
                <BR>Hosted on Sourceforge
                <BR><A href="http://sourceforge.net"><IMG src="$relativePath/$sflogosrc" width="125" height="37"
                       border="0" alt="SourceForge.net"></A>
                <BR>Users' eGroup
                <BR><a href="http://groups.yahoo.com/group/scope-dev-framework/join">
                      <img src="$relativePath/images/yahoo-join.gif" border=0 alt="Yahoo eGroup">
                    </a>

                    </td>
                    <td width="80%" align="left" valign="top">
                    #set ($allSections = $root.getChild("body").getChildren("section"))
                    #foreach ( $section in $allSections )
                        #section ($section)
                    #end
                    </td>
                </tr>

                <!-- FOOTER -->
                <tr><td colspan="2">
                    <hr noshade="" size="1"/>
                </td></tr>
                <tr><td colspan="2">
                    <div align="center"><font color="$bodylink" size="-1"><em>
                    Copyright &#169; 2000-2002, The Scope Team
                    </em></font></div>
                </td></tr>
            </table>
        </body>
    </html>
#end
